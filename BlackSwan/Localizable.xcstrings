        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedir el 50 % por adelantado en proyectos nuevos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander 50 % d’acompte sur les nouveaux projets"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedere il 50% in anticipo sui nuovi progetti"
          }
        }
      }
    },
    "Assume the painful surprise already happened. Then build buffers so the real version hurts less.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell dir vor, die schmerzhafte Überraschung ist schon passiert. Dann baue Puffer auf, damit es in Wirklichkeit weniger wehtut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagina que la sorpresa dolorosa ya ocurrió. Luego crea colchones para que la real duela menos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagine que la mauvaise surprise est déjà arrivée. Puis prépare des réserves pour que la vraie fasse moins mal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immagina che la brutta sorpresa sia già successa. Poi costruisci dei cuscinetti perché quella vera faccia meno male."
