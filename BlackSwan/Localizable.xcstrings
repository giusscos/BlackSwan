    "Write what happened. Black Swan classifies it on your device and suggests how to protect yourself next time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib auf, was passiert ist. Black Swan ordnet es auf deinem Gerät ein und zeigt dir, wie du dich beim nächsten Mal schützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe lo que pasó. Black Swan lo clasifica en tu dispositivo y te sugiere cómo protegerte la próxima vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris ce qui s’est passé. Black Swan le classe sur ton appareil et te dit comment te protéger la prochaine fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi cosa è successo. Black Swan lo classifica sul dispositivo e ti suggerisce come proteggerti la prossima volta."
          }
        }
      }
    },
    "Yearly": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jährlich"
          }
        },
        "es": {
