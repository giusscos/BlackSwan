    "After that it's %@. Keep it, or cancel anytime in Settings → Apple Account → Subscriptions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach kostet es %@. Behalte es oder kündige jederzeit unter Einstellungen → Apple Account → Abonnements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después cuesta %@. Mantenlo o cancélalo cuando quieras en Ajustes → Cuenta de Apple → Suscripciones."
          }
        },
        "fr": {
          "stringUnit": {
